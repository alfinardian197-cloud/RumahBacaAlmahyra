# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://rumah-baca-almahyra.vercel.app).
APP_URL="MY_APP_URL"

# ALMAHYRA_SESSION_SECRET: Random secret string for signing member & admin session tokens.
# Strongly recommended to set in Vercel Project Settings -> Environment Variables.
ALMAHYRA_SESSION_SECRET="REPLACE_WITH_RANDOM_32_CHAR_HEX"

# Optional persistent KV storage on Vercel (Vercel KV / Upstash Redis REST API).
# When omitted on Vercel, data uses bundled seed + writable /tmp storage.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
